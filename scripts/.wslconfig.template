# Docker Desktop WSL2 内存上限模板（Windows 宿主机）
# 用法：复制到 %UserProfile%\.wslconfig（如 C:\Users\<你>\.wslconfig），然后 wsl --shutdown 重启
#
# 背景：WSL2 默认吃掉 50% 物理内存（16GB 主机 = 8GB）。OpenForge 本地默认只跑
# PostgreSQL 一个容器（Redis/MinIO 为 extras 且零代码使用）——2GB 足够；
# 启用 EXTRAS=1（Redis+MinIO）或 rocketmq/nacos profile 时改回 4GB。
# 不限流时与 9 个 JVM 服务 + Vite + 浏览器叠加必然触发 Windows 提交内存耗尽
# （hs_err: malloc AllocateHeap / mmap G1 virtual space），见性能画像 §1。

[wsl2]
# 默认（仅 PG）：2GB；启用 extras/rocketmq/nacos：4GB
memory=2GB
processors=4
swap=2GB
# 回收不活跃内存（默认 cache 也不还给 Windows）
autoMemoryReclaim=gradual

[experimental]
# 稀疏 VHD：容器卷删除后回缩磁盘占位
sparseVhd=true
