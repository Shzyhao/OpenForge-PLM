{
  "uid": "openforge-gateway-events",
  "title": "OpenForge 网关与事件总线",
  "tags": ["openforge", "b2"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "job",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(http_server_requests_seconds_count, job)",
        "refresh": 1,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP 请求速率（按 job/uri/状态码）",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "rate(http_server_requests_seconds_count{job=\"$job\"}[5m])", "legendFormat": "{{method}} {{uri}} {{status}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP P95 延迟",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "histogram_quantile(0.95, rate(http_server_requests_seconds_bucket{job=\"$job\"}[5m]))", "legendFormat": "{{method}} {{uri}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "5xx 错误速率",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "rate(http_server_requests_seconds_count{job=\"$job\", status=~\"5..\"}[5m])", "legendFormat": "{{method}} {{uri}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "事件总线：发送/回退/失败（按 topic）",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "rate(openforge_events_sent_total[5m])", "legendFormat": "sent {{topic}}" },
        { "expr": "rate(openforge_events_fallback_total[5m])", "legendFormat": "fallback {{topic}}" },
        { "expr": "rate(openforge_events_send_failed_total[5m])", "legendFormat": "failed {{topic}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "事件总线：消费与重复投递（按 consumer/type）",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "rate(openforge_events_consumed_total[5m])", "legendFormat": "consumed {{type}}" },
        { "expr": "rate(openforge_events_duplicate_total[5m])", "legendFormat": "duplicate {{consumer}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "模块路由健康（网关 health DEGRADED 时非 1）",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "application_ready_time_seconds{job=\"openforge-gateway\"} > 0", "legendFormat": "gateway up" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    }
  ]
}
