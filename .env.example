# OpenForge PLM 生产环境配置样例（B4）
# 复制为 .env 并修改——:required 项缺省时 compose 拒绝启动，防默认值上线

# ---- 基础设施（required）----
PG_PASSWORD=change-me-pg
MINIO_ROOT_PASSWORD=change-me-minio

# ---- 安全（required）----
# JWT 签名密钥（≥32 字节，随机生成：openssl rand -base64 48）
JWT_SECRET=change-me-jwt-secret-at-least-32-bytes-long!
# 服务间内部令牌（内部 API 防护，随机生成）
INTERNAL_TOKEN=change-me-internal-token

# ---- LLM 接入（可选：缺省进入离线降级模式）----
OPENFORGE_LLM_BASE_URL=
OPENFORGE_LLM_API_KEY=
OPENFORGE_LLM_MODEL=glm-4-flash

# ---- Nacos 服务发现（可选，默认关闭；开启需自备 Nacos 并设置地址）----
NACOS_ENABLED=false
NACOS_ADDR=nacos:8848
